# Athletico Store — environment
# Copy to .env.local for development, and set the same values in the hosting
# dashboard for production. Nothing here is committed.

# ── Order book (required before the store can record an order) ──────────────
# The /exec URL of the deployed Apps Script web app — see docs/apps-script/Code.gs
ORDERS_WEBHOOK_URL=
# Must match CONFIG.SHARED_SECRET inside that script. Use a long random string.
ORDERS_SHARED_SECRET=

# ── Payment details shown at checkout ───────────────────────────────────────
# Until these are set, the checkout shows placeholder QR codes and a visible
# "setup pending" notice.
NEXT_PUBLIC_WHISH_NUMBER=
NEXT_PUBLIC_WHISH_NAME=
NEXT_PUBLIC_BOB_ACCOUNT=
NEXT_PUBLIC_BOB_NAME=

# ── Club contact ────────────────────────────────────────────────────────────
# Digits only, including country code. Defaults to the number already on the site.
NEXT_PUBLIC_WHATSAPP_NUMBER=96170202030

# ── Site ────────────────────────────────────────────────────────────────────
# Used to build absolute URLs for social share images.
NEXT_PUBLIC_SITE_URL=https://athleticosc.com
