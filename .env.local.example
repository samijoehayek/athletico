# Athletico Store — environment
# Copy to .env.local for development, and set the same values in the hosting
# dashboard for production. Nothing here is committed.

# ── Order book (required before the store can record an order) ──────────────
# The /exec URL of the deployed Apps Script web app — see docs/apps-script/Code.gs
ORDERS_WEBHOOK_URL=
# Must match the SHARED_SECRET script property in that Apps Script project
# (Project Settings → Script properties). Generate with: openssl rand -hex 32
ORDERS_SHARED_SECRET=

# ── Payments ────────────────────────────────────────────────────────────────
# A payment method is offered at checkout only once its credentials are set.
# BOB Wallet credentials are added in their own step; see docs/STORE.md.

# Card: Mastercard Gateway, Bank of Beirut. All three are needed to offer cards.
# Test: MPGS_MERCHANT_ID=TESTATHLETICO, MPGS_BASE_URL=https://test-bobsal.gateway.mastercard.com
# A merchant ID starting with TEST is refused on production deployments, because
# test cards would otherwise mark real orders as paid.
MPGS_MERCHANT_ID=
# Merchant portal: Admin → Integration Settings → Password 1. Not the login password.
MPGS_API_PASSWORD=
MPGS_BASE_URL=
# Merchant portal: Admin → Webhook Notifications. The webhook route answers 404 until set.
# Endpoint to register: https://<live domain>/api/payments/card/webhook
MPGS_WEBHOOK_SECRET=
# The site's public address, for the links back from the payment page. Only needed
# if Vercel's production URL isn't the domain customers use. https://athletico-lb.com
PAYMENTS_SITE_ORIGIN=

# Signs the links to order pages (/store/order/ATH-…?t=…). Any long random
# string; falls back to ORDERS_SHARED_SECRET when unset.
PAYMENT_TOKEN_SECRET=

# Test simulator standing in for both payment methods while credentials are
# pending: "1" to enable. Ignored on production deployments (VERCEL_ENV=production).
PAYMENTS_SIMULATOR=

# ── Site ────────────────────────────────────────────────────────────────────
# Used to build absolute URLs for social share images.
NEXT_PUBLIC_SITE_URL=https://athleticosc.com
